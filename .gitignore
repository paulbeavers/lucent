# Editor and OS cruft
*.swp
*.swo
*~
.DS_Store

# Nothing generated lands in this repo — monitors.conf and gpu.conf are written
# straight into ~/.config/hypr by install.sh, deliberately kept out of version
# control because they are machine-specific.

# Leftover ISO build output. The ISO tooling now lives in the starch repository;
# these directories are what an earlier in-tree build left behind, they are
# root-owned (mkarchiso runs under sudo) and git cannot even index them.
# Safe to delete with: sudo rm -rf iso/
iso/

# Python bytecode from lucent-config.
__pycache__/
*.pyc
