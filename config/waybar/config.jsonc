// Waybar — status bar
//
// Reload after editing:  killall -SIGUSR2 waybar   (bound to SUPER+SHIFT+R)
// Module reference:      https://github.com/Alexays/Waybar/wiki/Modules
{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left":   ["group/workspaces", "hyprland/submap", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["tray", "privacy", "idle_inhibitor", "pulseaudio", "bluetooth",
                     "network", "cpu", "memory", "temperature", "battery", "custom/power"],

  // ── left ────────────────────────────────────────────────────────────────
  // Waybar's own hyprland/workspaces module cannot switch workspaces when
  // Hyprland is configured in Lua. It hardcodes the IPC request
  //
  //     dispatch workspace 3
  //
  // and a Lua-configured Hyprland evaluates everything after `dispatch` as
  // Lua, where `hl.dispatch(workspace 3)` is a syntax error. The click is
  // swallowed and nothing is logged. Waybar offers no way to change the string
  // it sends, so the row is drawn here instead, one custom module per
  // workspace, each with an on-click that speaks Lua.
  //
  // Modules 6-10 print nothing while their workspace is empty, and waybar
  // hides a custom module with empty text — so the row still grows only as far
  // as you have used it, the way persistent-workspaces used to make it.
  //
  // They all carry signal 1: hypr/autostart.lua sends SIGRTMIN+1 to waybar
  // whenever a workspace or window changes, which re-runs all ten at once.
  //
  // Scroll is repeated on every module rather than set once on the group: a
  // group declaring on-scroll never sees the event, because the child modules
  // are what the pointer is actually over.
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"]
  },

  "custom/ws1": { "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'", "exec": "~/.config/waybar/scripts/workspace.sh 1", "return-type": "json", "interval": "once", "signal": 1, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'" },
  "custom/ws2": { "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'", "exec": "~/.config/waybar/scripts/workspace.sh 2", "return-type": "json", "interval": "once", "signal": 1, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'" },
  "custom/ws3": { "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'", "exec": "~/.config/waybar/scripts/workspace.sh 3", "return-type": "json", "interval": "once", "signal": 1, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'" },
  "custom/ws4": { "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'", "exec": "~/.config/waybar/scripts/workspace.sh 4", "return-type": "json", "interval": "once", "signal": 1, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'" },
  "custom/ws5": { "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'", "exec": "~/.config/waybar/scripts/workspace.sh 5", "return-type": "json", "interval": "once", "signal": 1, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'" },
  "custom/ws6": { "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'", "exec": "~/.config/waybar/scripts/workspace.sh 6", "return-type": "json", "interval": "once", "signal": 1, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'" },
  "custom/ws7": { "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'", "exec": "~/.config/waybar/scripts/workspace.sh 7", "return-type": "json", "interval": "once", "signal": 1, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'" },
  "custom/ws8": { "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'", "exec": "~/.config/waybar/scripts/workspace.sh 8", "return-type": "json", "interval": "once", "signal": 1, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'" },
  "custom/ws9": { "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'", "exec": "~/.config/waybar/scripts/workspace.sh 9", "return-type": "json", "interval": "once", "signal": 1, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'" },
  "custom/ws10": { "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'", "exec": "~/.config/waybar/scripts/workspace.sh 10", "return-type": "json", "interval": "once", "signal": 1, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 10 })'" },

  "hyprland/submap": {
    "format": "  {}",
    "tooltip": false
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 70,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "󰈹  $1",
      "(.*) - Chromium": "  $1",
      "(.*) - Visual Studio Code": "󰨞  $1",
      "~(.*)": "  ~$1"
    }
  },

  // ── center ──────────────────────────────────────────────────────────────
  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %d %B %Y  ·  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "format": {
        "months":  "<span color='#cba6f7'><b>{}</b></span>",
        "days":    "<span color='#cdd6f4'>{}</span>",
        "weeks":   "<span color='#74c7ec'><b>W{}</b></span>",
        "weekdays":"<span color='#fab387'><b>{}</b></span>",
        "today":   "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // ── right ───────────────────────────────────────────────────────────────
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "privacy": {
    // Shows an icon whenever something is recording the screen or the mic.
    "icon-spacing": 6,
    "icon-size": 13,
    "modules": [
      { "type": "screenshare", "tooltip": true },
      { "type": "audio-in",    "tooltip": true }
    ]
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "󰅶", "deactivated": "󰛊" },
    "tooltip-format-activated": "Idle inhibited — screen will not lock",
    "tooltip-format-deactivated": "Idle normal"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-bluetooth": "󰂰  {volume}%",
    "format-icons": { "headphone": "󰋋", "headset": "󰋎", "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀 no IP",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid}\n{ipaddr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "on-click": "~/.config/hypr/scripts/terminal.sh --class floating-term -e nmtui"
  },

  "cpu": {
    "interval": 3,
    "format": "  {usage}%",
    "on-click": "~/.config/hypr/scripts/terminal.sh --class floating-term -e btop"
  },

  "memory": {
    "interval": 5,
    "format": "  {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "on-click": "~/.config/hypr/scripts/terminal.sh --class floating-term -e btop"
  },

  "temperature": {
    // Falls back gracefully if the sensor path does not exist.
    "interval": 5,
    "critical-threshold": 82,
    "format": "  {temperatureC}°C",
    "format-critical": "  {temperatureC}°C"
  },

  "battery": {
    // Waybar hides this module automatically on a desktop with no battery.
    "interval": 10,
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": ["󰁺", "󰁽", "󰁿", "󰂁", "󰁹"]
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/powermenu.sh"
  }
}
