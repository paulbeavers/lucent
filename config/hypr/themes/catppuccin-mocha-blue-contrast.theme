# Catppuccin Mocha Blue High Contrast
# Catppuccin Mocha High Contrast with the highlight role swapped from purple to
# light blue, exactly as Catppuccin Mocha Blue does to Mocha: same background,
# same text, same everything — the focused border, active workspace, selected
# row and lock ring are blue instead of mauve.
#
# Roles, darkest background to brightest accent. Every themed config is
# rendered from exactly these keys — see hypr/scripts/theme.sh.
name = Catppuccin Mocha Blue High Contrast
mode = dark

crust     = 0c0c14
mantle    = 12121c
base      = 161622
surface0  = 4f5169   # inactive window border, and waybar panel fill
surface1  = 636680   # inactive workspace digits; also the terminal's ANSI black
overlay   = 8c91a8   # the dimmest readable text
subtext   = c0c7de
text      = e2e9fc
rosewater = f5e0dc
red       = f38ba8
peach     = fab387
yellow    = f9e2af
green     = a6e3a1
teal      = 94e2d5
sapphire  = 92d5f3
blue      = a0c5fd
lavender  = a0c5fd   # blue: the clock, which would otherwise stay purple
mauve     = 92d5f3   # sapphire: the highlight colour, deliberately
pink      = f5c2e7
