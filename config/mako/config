# mako — notification daemon
# Reload after editing:  makoctl reload
# Full options: man 5 mako

# ── placement ─────────────────────────────────────────────────────────────────
# Sized for the top bar of dock style: 38px bar + 6px margin + a little
# breathing room. In the default panel style the panel is at the bottom, so
# this only leaves a gap at the top.
anchor=top-right
margin=10,14,10
outer-margin=52,0,0,0
max-visible=5
layer=overlay

# ── appearance ────────────────────────────────────────────────────────────────
font=JetBrainsMono Nerd Font 11

width=380
height=160
padding=14
border-size=2
border-radius=12
icon-location=left
max-icon-size=48

# Pango markup in the body, so apps can use <b> and links.
markup=1
format=<b>%s</b>\n%b

# ── behaviour ─────────────────────────────────────────────────────────────────
default-timeout=6000
ignore-timeout=0
group-by=app-name

on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss

# ── colours and per-urgency overrides ─────────────────────────────────────────
# mako has no variables, so the generated file carries the colours and every
# section that sets one. It is written by hypr/scripts/theme.sh; SUPER+SHIFT+T
# switches the theme. This include has to come before any section declared
# here, because mako applies keys to whichever section was opened last.
include=~/.config/mako/colors

# Volume and brightness popups come from swayosd, so suppress duplicates.
# The section header re-scopes after the include above.
[app-name=swayosd]
invisible=1
